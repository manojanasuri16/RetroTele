// tgnative.pyd: RetroTele's compiled crypto for Python for S60 1.4.5 (3rd Edition).
// Python finds it with imp.load_dynamic("tgnative", "tgnative.pyd") in \sys\bin.
// It must have at least the capabilities of RetroTele's own exe.
TARGET        tgnative.pyd
TARGETTYPE    dll
UID           0x1000008d 0xE7A3D5C3
CAPABILITY    NetworkServices LocalServices ReadUserData WriteUserData UserEnvironment
VENDORID      0
EPOCSTACKSIZE 0x8000

NOSTRICTDEF
EXPORTUNFROZEN

SYSTEMINCLUDE \epoc32\include
SYSTEMINCLUDE \epoc32\include\libc
SYSTEMINCLUDE \epoc32\include\python

SOURCEPATH    ..
SOURCE        tgnative.c

LIBRARY       python222.lib euser.lib estlib.lib
